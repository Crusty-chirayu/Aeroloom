# ==============================================================================
# AEROLOOM: THE ATMOSPHERIC OBSERVATORY
# Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required for Auth & Cloud Sync)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------

# Project URL: Found under Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Publishable Key: Found under Project Settings -> API -> Project API Keys (anon public)
# Safe for exposure in browser client bundles. RLS policies enforce data isolation.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Service Role Secret: Found under Project Settings -> API -> Project API Keys (service_role secret)
# SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-placeholder

# ------------------------------------------------------------------------------
# 2. Application Deployment URL (Auth redirects & CORS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Live ADS-B Data Providers (Optional overrides)
# Aeroloom uses open, public ADS-B endpoints (airplanes.live, adsb.lol) with zero paid keys.
# ------------------------------------------------------------------------------
ADSB_PROVIDER_PRIMARY=airplanes.live
ADSB_CACHE_TTL_MS=4000
