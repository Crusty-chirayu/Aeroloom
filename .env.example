# ==============================================================================
# AEROLOOM: THE ATMOSPHERIC OBSERVATORY
# Environment Configuration Template
#
# Instructions:
# 1. Copy this template to `.env.local` for local development:
#    cp .env.example .env.local
# 2. Never commit `.env.local`, API keys, or production secrets to Git.
# 3. For local zero-cost evaluation, ALL third-party keys are OPTIONAL.
#    Aeroloom will automatically fall back to in-memory caching, guest mode,
#    and public open feeds.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL SITE CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED for Production / OPTIONAL for Local Development]
# Canonical public URL of the application. Used for Open Graph generation,
# sitemaps, robots.txt, and OAuth redirect callbacks.
# Default (local): http://localhost:3000
# Production: https://your-domain.com or https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. UPSTASH REDIS (Multi-Tier Caching & Rate Limiting Shield)
# ------------------------------------------------------------------------------
# [OPTIONAL: Free tier available at https://console.upstash.com]
# If omitted, Aeroloom automatically falls back to an in-memory LRU cache
# with zero degradation for single-instance local runs.
#
# REST API URL from your Upstash Redis database dashboard
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io

# REST API Bearer Token from your Upstash Redis database dashboard
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-placeholder

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD (Authentication, User Watchlists & Cloud Persistence)
# ------------------------------------------------------------------------------
# [OPTIONAL: Free tier available at https://supabase.com]
# If omitted, Aeroloom runs in 100% Guest Mode using local storage persistence.
#
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key: Found in Supabase Dashboard -> Project Settings -> API
# Safe for browser client bundles; protected by Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Service Role Secret: Found in Supabase Dashboard -> Project Settings -> API
# SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_. Bypasses RLS for secure admin tasks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-placeholder

# ------------------------------------------------------------------------------
# 4. OPENROUTER AI ASSISTANT ("Ask Aeroloom" Grounded Assistant)
# ------------------------------------------------------------------------------
# [OPTIONAL: Free model access available at https://openrouter.ai]
# If omitted, the assistant gracefully displays a setup prompt in development
# and is unobtrusively hidden in production.
#
# Server-only API key from OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-placeholder

# Comma-separated list of free-tier model identifiers in fallback priority order.
# Aeroloom automatically falls through to the next model upon rate limits (429) or timeouts.
ASSISTANT_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-72b-instruct:free

# ------------------------------------------------------------------------------
# 5. LIVE TELEMETRY & RADAR OVERRIDES
# ------------------------------------------------------------------------------
# [OPTIONAL: Aeroloom ships with pre-configured public endpoints and sensible defaults]
# Primary ADS-B telemetry provider ('airplanes.live' or 'adsb.lol')
ADSB_PROVIDER_PRIMARY=airplanes.live

# Telemetry cache TTL in milliseconds (default: 4000ms = 4 seconds)
ADSB_CACHE_TTL_MS=4000

# Weather radar index cache TTL in milliseconds (default: 300000ms = 5 minutes)
RAINVIEWER_CACHE_TTL_MS=300000
